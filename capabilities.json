{
    "dataRoles": [
        {
            "displayName": "Location",
            "name": "location",
            "kind": "Grouping",
            "description": "Address, city, postal code, state or country. Put several fields here (e.g. City, Province, Country) and they're combined. Rows that also have Latitude/Longitude use those instead."
        },
        {
            "displayName": "Latitude",
            "name": "latitude",
            "kind": "Grouping",
            "requiredTypes": [
                {
                    "numeric": true
                },
                {
                    "integer": true
                }
            ],
            "preferredTypes": [
                {
                    "geography": {
                        "latitude": true
                    }
                }
            ],
            "description": "Optional. Overrides Location for rows that have it."
        },
        {
            "displayName": "Longitude",
            "name": "longitude",
            "kind": "Grouping",
            "requiredTypes": [
                {
                    "numeric": true
                },
                {
                    "integer": true
                }
            ],
            "preferredTypes": [
                {
                    "geography": {
                        "longitude": true
                    }
                }
            ],
            "description": "Optional. Overrides Location for rows that have it."
        },
        {
            "displayName": "Legend",
            "name": "legend",
            "kind": "Grouping"
        },
        {
            "displayName": "Size",
            "name": "size",
            "kind": "Measure"
        },
        {
            "displayName": "Label value",
            "name": "labelValue",
            "kind": "Measure",
            "description": "The value printed on each point. A measure or any column (use First/Last for text)."
        },
        {
            "displayName": "Tooltips",
            "name": "tooltips",
            "kind": "Measure"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "location": {
                        "max": 5
                    },
                    "latitude": {
                        "max": 1
                    },
                    "longitude": {
                        "max": 1
                    },
                    "labelValue": {
                        "max": 1
                    },
                    "size": {
                        "max": 1
                    },
                    "legend": {
                        "max": 1
                    }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        {
                            "for": {
                                "in": "location"
                            }
                        },
                        {
                            "for": {
                                "in": "latitude"
                            }
                        },
                        {
                            "for": {
                                "in": "longitude"
                            }
                        },
                        {
                            "for": {
                                "in": "legend"
                            }
                        },
                        {
                            "for": {
                                "in": "labelValue"
                            }
                        },
                        {
                            "for": {
                                "in": "size"
                            }
                        },
                        {
                            "for": {
                                "in": "tooltips"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30000
                        }
                    }
                }
            }
        }
